diff --git a/src/main/java/bugs/OrderParser.java b/src/main/java/bugs/OrderParser.java
index 44f7d83..0fb99ea 100644
--- a/src/main/java/bugs/OrderParser.java
+++ b/src/main/java/bugs/OrderParser.java
@@ -8,7 +8,22 @@ package bugs;
 public class OrderParser {
 
     public double parsePrice(String line) {
-        String value = line.split(":")[1];
-        return Double.parseDouble(value);
+        if (line == null) {
+            throw new IllegalArgumentException("line is required");
+        }
+        int separator = line.indexOf(':');
+        if (separator < 0 || separator == line.length() - 1) {
+            throw new IllegalArgumentException("invalid price line: " + line);
+        }
+        double value;
+        try {
+            value = Double.parseDouble(line.substring(separator + 1).trim());
+        } catch (NumberFormatException e) {
+            throw new IllegalArgumentException("invalid price: " + line, e);
+        }
+        if (value < 0) {
+            throw new IllegalArgumentException("price must be >= 0: " + line);
+        }
+        return value;
     }
 }
