diff --git a/src/main/java/shop/OrderService.java b/src/main/java/shop/OrderService.java
index a1c930e..d24db6b 100644
--- a/src/main/java/shop/OrderService.java
+++ b/src/main/java/shop/OrderService.java
@@ -41,4 +41,11 @@ public class OrderService {
         }
         return total;
     }
+
+    public double calculateTotal(Map<String, Integer> items, double discountRate) {
+        if (discountRate < 0 || discountRate > 1) {
+            throw new IllegalArgumentException("discountRate must be between 0 and 1");
+        }
+        return calculateTotal(items) * (1 - discountRate);
+    }
 }
