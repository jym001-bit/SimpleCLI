# PaiCLI 配置示例
# 用法：
# 1. 复制本文件为 .env
# 2. 按需填写下面的配置项
# 3. 未填写的项会回退到代码默认值

# ========== Langfuse 可选观测 ==========
# 默认关闭；启用后仅发送模式、模型、Token、工具名、耗时和成败，不发送提示词或工具内容。
# 密钥优先放在 Windows 用户环境变量，不要提交真实密钥到 .env 或 Git。
# LANGFUSE_ENABLED=true
# 兼容旧配置：PAICLI_LANGFUSE_ENABLED=true（若同时设置，以 LANGFUSE_ENABLED 为准）
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# 欧盟云端地址；其他区域或本地部署按实际地址修改。
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ========== DeepSeek 配置（默认） ==========
# 当前默认模型为 DeepSeek V4.1 Flash。模型迭代很快，后续默认模型可能继续升级，请以本文件和 README 为准。
# API Key（必填其一：DEEPSEEK_API_KEY、GLM_API_KEY、HUNYUAN_API_KEY、STEP_API_KEY、KIMI_API_KEY、FREELLMAPI_API_KEY、XFYUN_MAAS_API_KEY 或 AGNES_API_KEY）
# 未在 ~/.paicli/config.json 保存默认 provider 时，优先使用 DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# 模型名称（可选，默认 deepseek-flash，即 DeepSeek V4.1 Flash）
# 启动时显式环境变量 / .env 模型优先于 config.json 保存的上次选择；会话内仍可用 /model 切换
# 可选值：deepseek-flash（支持图片）, deepseek-v4-pro（仅文本）
# 旧名 deepseek-v4-flash / deepseek-v4-flash-vision-exp 由官方转到 V4.1 Flash，请使用 deepseek-flash
# DEEPSEEK_MODEL=deepseek-flash
# 手动管理：/model list、/model refresh deepseek、/model add deepseek <id> --like deepseek-flash
# 能力覆盖保存在 ~/.paicli/config.json；添加/刷新后需 /model <provider>/<id> 才切换。

# ========== auto 模式审批分类器 ==========
# auto 模式下每条 Shell 命令先由轻量模型审查（关闭思考、最多 400 token），默认沿用当前会话的供应商和模型。
# 可指定同一供应商下更便宜的模型 ID，例如：
# PAICLI_AUTO_CLASSIFIER_MODEL=deepseek-flash

# ========== GLM 配置 ==========
# API Key（/model glm-5.3-flash 等切换后使用；配置后联网搜索默认也走智谱 Web Search）
# GLM_API_KEY=your_api_key_here
# 模型名称（可选，默认 glm-5.1）
# 可选值：glm-5.3-flash, glm-5.1, glm-5v-turbo, glm-5.0, glm-4-flash 等
# glm-5v-turbo 支持图片输入，可配合 Ctrl+V / @image: 使用
# GLM_MODEL=glm-5.3-flash

# ========== 腾讯混元 TokenHub 配置 ==========
# API Key（/model hunyuan 或 /model hy4-preview 切换后使用）
# 兼容 TOKENHUB_API_KEY / TENCENTMAAS_API_KEY；若同时配置，按本段从上到下优先。
# HUNYUAN_API_KEY=your_hunyuan_api_key_here
# TOKENHUB_API_KEY=your_tokenhub_api_key_here
# TENCENTMAAS_API_KEY=your_tencentmaas_api_key_here
# 模型名称（可选，默认 hy4-preview）
# HUNYUAN_MODEL=hy4-preview
# Base URL（可选，默认 https://tokenhub.tencentmaas.com/v1）
# HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1

# ========== 阶跃星辰 StepFun 配置 ==========
# API Key（/model step 切换后使用）
# STEP_API_KEY=your_step_api_key_here
# 模型名称（可选，默认 step-3.5-flash）
# 可选值：step-3.5-flash, step-3.5-flash-2603, step-router-v1, step-1-256k 等
# STEP_MODEL=step-3.5-flash
# Base URL（可选，默认 https://api.stepfun.com/v1）
# 如果使用 Step Plan 专用通道，可设置为 https://api.stepfun.com/step_plan/v1
# STEP_BASE_URL=https://api.stepfun.com/v1

# ========== Kimi / Moonshot 配置 ==========
# API Key（/model kimi 切换后使用；兼容官方 MOONSHOT_API_KEY）
# KIMI_API_KEY=your_kimi_api_key_here
# MOONSHOT_API_KEY=your_moonshot_api_key_here
# 模型名称（可选，默认 kimi-k2.6；兼容 MOONSHOT_MODEL）
# KIMI_MODEL=kimi-k2.6
# Base URL（可选，默认 https://api.moonshot.ai/v1；兼容 MOONSHOT_BASE_URL）
# KIMI_BASE_URL=https://api.moonshot.ai/v1

# ========== FreeLLMAPI 本地网关配置 ==========
# API Key（/model freellmapi 切换后使用；可从 FreeLLMAPI /keys 顶部 unified API key 复制）
# FREELLMAPI_API_KEY=your_freellmapi_unified_key_here
# 模型名称（可选，默认 auto；也可填 /v1/models 返回的具体 model id）
# FREELLMAPI_MODEL=auto
# Base URL（可选，默认 http://localhost:5173/v1）
# FREELLMAPI_BASE_URL=http://localhost:5173/v1

# ========== Agnes AI 配置 ==========
# API Key（/model agnes 切换后使用；从 Agnes AI Platform 创建）
# AGNES_API_KEY=your_agnes_api_key_here
# 模型名称（可选，默认 agnes-2.0-flash）
# AGNES_MODEL=agnes-2.0-flash
# Base URL（可选，默认 https://apihub.agnes-ai.com/v1）
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# Embedding 配置（用于 /index、/search、Agent 的代码检索）
# 支持 provider：ollama / openai / zhipu / glm
# 不配置时默认使用 ollama + nomic-embed-text:latest + http://localhost:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_BASE_URL=http://localhost:11434

# 如果使用需要鉴权的远程 Embedding 服务，再打开这一项
# EMBEDDING_API_KEY=your_api_key_here

# /index 时每次请求向量化多少条（默认 32）；远程服务限制单次条数时调小
# EMBEDDING_BATCH_SIZE=32
# /index 解析文件的线程数（默认 4，实测 8 线程反而更慢）
# PAICLI_INDEX_THREADS=4

# ========== Web 搜索配置 ==========
# AgentBench MOCK_WEB 原生/relay v8 离线诊断通过代码绑定封闭宿主依赖，无环境变量开关；不替换交互式 Web provider，未开放正式准入。
# 其 Docker host relay 尚未接入，正式/宿主 Worker 仍拒绝该评测 profile。
# 选择搜索 provider（zhipu | serpapi | searxng | deepseek），不配置时按 Key/URL 自动判断：
# 1. 有 GLM_API_KEY → zhipu（默认推荐：与 GLM 推理共用 Key，零额外配置，国内首选）
# 2. 有 SERPAPI_KEY → serpapi（国际通用，付费即开即用）
# 3. 有 SEARXNG_URL → searxng（开源自托管，免费，需本地跑 docker 实例）
# 4. 有 DEEPSEEK_API_KEY → deepseek（仅配置 DeepSeek Key 也能搜索；保留已有搜索服务优先级）
# SEARCH_PROVIDER=zhipu

# DeepSeek 原生搜索（SEARCH_PROVIDER=deepseek 可覆盖自动选择，复用 DEEPSEEK_API_KEY）
# 通过 Anthropic Messages API 发起独立模型请求，产生额外 Token 费用；默认 120 秒总超时，不自动重试。
# 搜索模型独立于对话模型；结果数量在本地截断，不减少服务端搜索调用。
# DEEPSEEK_SEARCH_MODEL=deepseek-flash

# 智谱 Web Search 引擎（SEARCH_PROVIDER=zhipu 时启用）
# 可选：search_std（0.01 元/次，默认）、search_pro（0.03 元/次）、
#       search_pro_sogou（0.05 元/次，搜狗）、search_pro_quark（0.05 元/次，夸克）
# 中文搜索建议用 search_pro 或搜狗 / 夸克版本，效果优于通用 std
# ZHIPU_SEARCH_ENGINE=search_std

# SerpAPI Key（SEARCH_PROVIDER=serpapi 时启用）
# 免费 100 次/月：https://serpapi.com/manage-api-key
# SERPAPI_KEY=your_serpapi_key_here

# SearXNG 实例地址（SEARCH_PROVIDER=searxng 时启用）
# 本地 docker：docker run --rm -p 8888:8888 searxng/searxng
# 公共实例（不稳定，仅试玩）：见 https://searx.space
# SEARXNG_URL=http://localhost:8888

# ========== Web 抓取配置 ==========
# web_fetch 工具：抓取 URL 并提取正文 Markdown
# 当前实现走「直接 HTTP + Jsoup + 简易 readability」，对静态/SSR 页面有效
# 对 SPA / 防爬墙站点会返回空正文（已知边界），Agent 会 fallback 到 Chrome DevTools MCP
# 默认安全策略：屏蔽 file:// / 内网 / loopback；30 秒超时；5MB 响应上限；每分钟 30 次限流

# ========== MCP 配置 ==========
# MCP server 配置文件位置：
# 1. 用户级 ~/.paicli/mcp.json
# 2. 项目级 .paicli/mcp.json（按 server 名覆盖用户级）
# 支持 ${PROJECT_DIR}、${HOME} 和环境变量 ${VAR} 展开。
# 远程 Streamable HTTP server 常用 token 示例：
# REMOTE_TOKEN=your_remote_mcp_token_here

# ========== 渲染器形态（v16.1+）==========
# 默认 inline 流式 TUI（Claude Code 风格：底部状态栏 + 行内可折叠工具块 + 行内 diff）
# PAICLI_RENDERER=inline    # 默认值，显式声明
# PAICLI_RENDERER=lanterna  # 切换到 Lanterna 三栏全屏 TUI（v16 形态，可选保留）
# PAICLI_RENDERER=plain     # 纯 println 兜底，无折叠/状态栏
# PAICLI_NO_STATUSBAR=true  # inline 模式下禁用底部状态栏（终端不支持 DECSTBM 时使用）

# 兼容旧设置：PAICLI_TUI=true 自动映射为 PAICLI_RENDERER=lanterna（已 deprecated）
# PAICLI_TUI=true

# ========== LSP 诊断注入（第 17 期）==========
# write_file 成功后触发 post-edit 诊断；当前 MVP 对 Java 文件使用 JavaParser 语法诊断，
# 不依赖本机安装 JDT LS。后续接真实 LSP server 时复用同一注入链路。
# PAICLI_LSP_ENABLED=true
# PAICLI_LSP_MAX_DIAGNOSTICS=20

# ========== Session Memory 自动压缩（实验功能）==========
# 默认 false：conversationHistory 到阈值时直接做完整摘要。
# 开启后会在阈值前异步维护当前 Agent 专属的增量会话摘要；达到阈值时优先使用该摘要，
# 摘要不可用、状态失效或压缩后仍超阈值时自动回退完整摘要。
# PAICLI_SESSION_MEMORY_COMPACTION_ENABLED=false

# ========== 长期记忆新鲜度与冲突检测 ==========
# 交互式 CLI 默认自动从已完成任务的用户原文提取项目级稳定事实；嵌入式 Agent 默认关闭。
# 每次符合候选条件的输入会多一次无工具模型调用；设为 false 可关闭。
# PAICLI_MEMORY_AUTO_EXTRACT_ENABLED=true
# 超过多少天未核实的长期记忆在注入 system prompt 和 /memory list 时标注“可能已过时”；<=0 关闭标注
# PAICLI_MEMORY_STALE_DAYS=30
# 显式保存记忆时的冲突检测阈值（字符二元组 Dice 系数，0~1）；仅数字/版本号不同的条目无论阈值都视为冲突
# PAICLI_MEMORY_CONFLICT_THRESHOLD=0.8
# 会话读过 web_search / web_fetch / 浏览器 / MCP 等外部内容后，不再自动写长期记忆；
# save_memory 需要用户当轮原文明确要求“记住”。显式保存的条目 metadata 记录 external_context=true。
# PAICLI_MEMORY_DISABLE_ON_EXTERNAL_CONTEXT=true

# ========== 工具输出可恢复卸载 ==========
# 超过阈值的工具结果完整写入项目内 .paicli/tool-outputs/<session>/，上下文只保留摘要、路径和首尾预览
# PAICLI_TOOL_OFFLOAD_ENABLED=true
# PAICLI_TOOL_OFFLOAD_THRESHOLD_CHARS=32000

# ========== 旧工具结果清理（摘要之前的中间一档）==========
# 上下文达到清理阈值时，把最近 N 条之外的旧工具结果换成占位说明（可重新调用工具或读回卸载文件）。
# 默认阈值 = min(100000, 摘要阈值 × 0.6)，始终低于摘要阈值；显式配置的值也会被压到摘要阈值以下。
# PAICLI_TOOL_RESULT_CLEARING_ENABLED=true
# PAICLI_TOOL_RESULT_CLEARING_TRIGGER_TOKENS=100000
# PAICLI_TOOL_RESULT_CLEARING_KEEP=3
# PAICLI_TOOL_RESULT_CLEARING_EXCLUDE_TOOLS=load_skill

# ========== execute_command 命令沙箱 ==========
# off（默认，与旧版一致）/ auto（macOS Seatbelt、Linux bubblewrap 可用则启用，否则提示并直接执行）
# / required（沙箱不可用时拒绝执行命令）。沙箱内只有工作区可写、没有网络，HOME 位于工作区
# .paicli-command-sandbox/，因此 mvn / npm install / git push 等命令会失败。
# PAICLI_COMMAND_SANDBOX=off

# ========== Side-Git 快照与回滚（第 18 期）==========
# 每个用户 turn 开始前创建 pre-turn 快照，结束后异步创建 post-turn 快照。
# 快照仓库位于 ~/.paicli/snapshots/<project_hash>/<worktree_hash>/.git，不写用户项目 .git。
# PAICLI_SNAPSHOT_ENABLED=true
# PAICLI_SNAPSHOT_MAX=50
# PAICLI_SNAPSHOT_EXCLUDES=.git,.paicli/snapshots,target,node_modules,dist,.idea,*.class,*.jar
# PAICLI_SNAPSHOT_DIR=/Users/yourname/.paicli/snapshots

# ========== 后台任务 + Runtime API（第 20 期）==========
# 后台任务 SQLite 队列默认位于 ~/.paicli/tasks/tasks.db
# PAICLI_TASK_DIR=/Users/yourname/.paicli/tasks
# 后台任务 worker 数，默认 2
# PAICLI_TASK_WORKERS=2

# Runtime API 仅监听 127.0.0.1，并强制要求 API Key。
# 启动示例：
#   PAICLI_RUNTIME_API_KEY=your_local_api_key java -jar target/paicli-1.0-SNAPSHOT.jar serve --http --port 8080
# 请求头：
#   Authorization: Bearer your_local_api_key
# 或：
#   X-PaiCLI-API-Key: your_local_api_key
# PAICLI_RUNTIME_API_KEY=your_local_api_key
# PAICLI_RUNTIME_DIR=/Users/yourname/.paicli/runtime

# ========== Chrome DevTools MCP ==========
# ~/.paicli/mcp.json 不存在时，PaiCLI 会自动创建默认 chrome-devtools 配置：
# npx -y chrome-devtools-mcp@latest --isolated=true
# isolated 模式使用临时 user-data-dir；复用登录态时，Chrome 144+ 推荐在
# chrome://inspect/#remote-debugging 勾选 Allow remote debugging for this browser instance，
# 然后让 Agent 自动调用 browser_connect，或手动执行 /browser connect。
# 如果希望默认连接调试 Chrome，可手动把 ~/.paicli/mcp.json args 改成：
# ["-y", "chrome-devtools-mcp@latest", "--autoConnect"]
# 旧式 CDP HTTP JSON 端口可改成：
# ["-y", "chrome-devtools-mcp@latest", "--browser-url=http://127.0.0.1:9222"]
# 如果首次启动 npx 拉包或 Chrome 冷启较慢，可调长 MCP initialize 超时：
# PAICLI_MCP_INITIALIZE_TIMEOUT_SECONDS=60
# 本地 stdio MCP server 的探活间隔（秒），连续 2 次 ping 不回判定卡死并自动重启；0 表示关闭
# PAICLI_MCP_PING_INTERVAL_SECONDS=30

# ========== LLM HTTP 超时与重试（可选）==========
# SSE 流式接口下，readTimeout 是"两次 read 之间最大间隔"。
# GLM-5.1 在生成大段 reasoning_content 时服务端可能长时间静默，超时容易触发。
# 仅当遇到频繁 "调用 LLM 失败: timeout" 时再调大；通过 -D 系统属性传入：
#   java -Dpaicli.llm.read.timeout.seconds=600 -jar target/paicli-1.0-SNAPSHOT.jar
# 默认值：connect=60s / read=300s / write=60s / call=600s
# 408 / 429 / 500 / 502 / 503 / 504 与瞬时连接故障默认总尝试 3 次（即最多重试 2 次）。
# 可用系统属性调整；max-delay 同时限制指数退避与 Retry-After，避免异常长时间阻塞：
#   -Dpaicli.llm.retry.max-attempts=3
#   -Dpaicli.llm.retry.base-delay.millis=500
#   -Dpaicli.llm.retry.max-delay.millis=30000
# Agent 默认不限制 ReAct / Plan 单任务 / SubAgent 的执行轮数。
# CI、Runtime API、微信无人值守或严格成本控制场景可显式设置正整数上限；
# 命中后会禁用工具并额外执行一次部分结果收尾：
#   java -Dpaicli.react.hard.max.iterations=100 -jar target/paicli-1.0-SNAPSHOT.jar
# Plan 模式任务失败且完成度低于 50% 时会重新规划，默认最多 2 次；
# 达到上限后停止启动新任务，其余任务标记为跳过。设为 0 表示失败后不重新规划：
# PAICLI_PLAN_MAX_REPLANS=2

# 日志配置（支持自动滚动、压缩和清理）
# 默认日志目录：~/.paicli/logs
# 默认日志文件：~/.paicli/logs/paicli.log
# 日志级别可选：ERROR / WARN / INFO / DEBUG
PAICLI_LOG_LEVEL=INFO

# 日志目录。建议填绝对路径
PAICLI_LOG_DIR=/Users/yourname/.paicli/logs

# 最多保留多少天的历史日志
PAICLI_LOG_MAX_HISTORY=7

# 单个日志文件滚动前的最大体积
PAICLI_LOG_MAX_FILE_SIZE=10MB

# 所有归档日志允许占用的总容量，超出后会自动清理更老的日志
PAICLI_LOG_TOTAL_SIZE_CAP=100MB

# ========== 操作审计配置 ==========
# 危险工具（write_file / execute_command / create_project / revert_turn）调用会按天写一行 JSONL 审计
# 默认目录：~/.paicli/audit/audit-YYYY-MM-DD.jsonl
# 也可通过 -Dpaicli.audit.dir=/path/to/dir 系统属性覆盖
# PAICLI_AUDIT_DIR=/Users/yourname/.paicli/audit

# ========== 第 15 期：Skill 系统 ==========
# Skill 加载位置（按优先级，后者覆盖前者）：
#   1. jar 内置 (resources/skills/) — PaiCLI 自带 web-access
#   2. 用户级 ~/.paicli/skills/<name>/SKILL.md
#   3. 项目级 <project>/.paicli/skills/<name>/SKILL.md
# 启动期 jar 内置 skill 自动解压到 ~/.paicli/skills-cache/<name>/，避免每次启动 IO
# 状态持久化：~/.paicli/skills.json （{"disabled": [...], "trustedProjectSkills": [...]}，默认全启用；项目级 skill 需 /skill trust 后才作为可信指引注入）
# 内置 web-access 含决策手册 + 6 个 site-patterns（mp.weixin / zhihu / x.com / xiaohongshu / github / juejin）
# CLI: /skill list | /skill show <name> | /skill on/off <name> | /skill trust <name> | /skill reload
# LLM 自决加载：当 system prompt 里某个 skill 的 description 匹配任务时，LLM 调 load_skill(name) 加载完整指引
# 同一会话注入的 Skill 正文合计上限（字符，默认 16384，最小 5120）；超出时新的 load_skill 不再注入
# PAICLI_SKILL_BODY_BUDGET=16384

# OpenCode Go 套餐，CLI 中 /model opencode-go 切换
# OPENCODE_GO_API_KEY=your_opencode_go_key
# OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1
# OPENCODE_GO_MODEL=deepseek-v4.1-flash
